{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lesserv-cloud",
  "main": "src/worker.py",
  // M4: deployed control plane. compatibility_date >= 2026-09-08 selects
  // Python 3.14 via pywrangler; if packages misbehave, pin 3.13 by adding
  // "python_workers_20250116".
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["python_workers"],
  // The admin surface needs a zone (Cloudflare Access), so workers.dev is
  // disabled and the Worker takes the whole hostname as a custom domain.
  "workers_dev": false,
  "routes": [{ "pattern": "cp.example.org", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lesserv",
      // Placeholder UUID for local development (pywrangler/wrangler dev
      // ignores it and uses a local database). Replace the name and id
      // with your own account's values before deploying — see
      // docs/DEPLOY.md, and keep the real values uncommitted (e.g. in a
      // gitignored wrangler.local.jsonc deployed with --config).
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // Static assets own /admin (built by frontend/, nested to mirror the
  // path). Assets are matched before the Worker, so /admin/* never
  // invokes Python and the route-group guard keeps its four prefixes.
  "assets": {
    "directory": "./frontend/dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
